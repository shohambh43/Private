{%- comment -%}
  Organization structured data (Schema.org / JSON-LD) - sitewide.
  Tells search engines the business's official identity: legal name, logo,
  mailing address, and official social profiles. This renders nothing
  visible on the page - it's read by search engines only (view via
  "View Page Source" or Google's Rich Results Test).
{%- endcomment -%}
{%- assign org_logo = 'gotze_-_R2-1_T_6c9a8b80-f2cf-4156-b07c-fd269a7acd27.png' | file_img_url: '600x' -%}
{%- unless org_logo contains 'http' -%}
  {%- assign org_logo = org_logo | prepend: 'https:' -%}
{%- endunless -%}
{%- assign org_social_ids = 'social_facebook,social_twitter,social_pinterest,social_instagram,social_tumblr,social_vimeo,social_youtube,social_linkedin' | split: ',' -%}
{%- assign org_social_links = '' -%}
{%- for handle in org_social_ids -%}
  {%- assign social_url = settings[handle] -%}
  {%- if social_url != blank -%}
    {%- assign org_social_links = org_social_links | append: social_url | append: '||' -%}
  {%- endif -%}
{%- endfor -%}
<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@type": "Organization",
  "name": {{ "Götze LLC" | json }},
  "url": {{ shop.url | json }},
  "logo": {{ org_logo | json }},
  "address": {
    "@type": "PostalAddress",
    "streetAddress": {{ "Attn: Privacy Compliance Officer, 2621 W Woodland Dr" | json }},
    "addressLocality": "Anaheim",
    "addressRegion": "CA",
    "postalCode": "92801",
    "addressCountry": "US"
  },
  "contactPoint": {
    "@type": "ContactPoint",
    "telephone": {{ "+1 646-581-2510" | json }},
    "contactType": "customer service"
  }
  {%- if org_social_links != blank -%}
  ,"sameAs": [
    {%- assign org_social_links_arr = org_social_links | split: '||' -%}
    {%- for link in org_social_links_arr -%}
      {{ link | json }}{%- unless forloop.last -%},{%- endunless -%}
    {%- endfor -%}
  ]
  {%- endif -%}
}
</script>
